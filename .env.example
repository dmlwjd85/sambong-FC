# GitHub Pages (예: https://dmlwjd85.github.io/sambong-FC/ ) → 저장소 이름과 동일한 경로
VITE_BASE=/sambong-FC/

# Firestore 문서 경로에 쓰이는 앱 ID (기본: sambong-futsal-ultimate)
# VITE_APP_ID=sambong-futsal-ultimate

# 메이트(학급 앱) artifacts/{appId} — 승부예측 연동 대상
# VITE_MATE_APP_ID=sambong-class-2026

# Firebase (비우면 initApp.js 내 기본 설정 사용)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
