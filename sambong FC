<!DOCTYPE html>
<html lang="ko" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>삼봉초 풋살클럽: 얼티밋 스쿼드</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700;900&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sans': ['Noto Sans KR', 'sans-serif'],
                        'display': ['Black Han Sans', 'sans-serif'],
                        'oswald': ['Oswald', 'sans-serif'],
                    },
                    colors: {
                        'pitch-bg': '#0a1912',
                        'pitch-panel': '#11291d',
                        'fut-gold': '#e8c271',
                        'fut-gold-dark': '#b08d41',
                        'fut-rare': '#38ff8e',
                    }
                }
            }
        }
    </script>

    <style>
        body { background-color: #0a1912; color: #f8fafc; overflow-x: hidden; background-image: radial-gradient(circle at 50% -20%, #15452d, #0a1912); }
        h1, h2, h3, .font-display { font-family: 'Black Han Sans', sans-serif; letter-spacing: 1px; }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0a1912; }
        ::-webkit-scrollbar-thumb { background: #1f422e; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #e8c271; }

        .glass-panel { background: rgba(17, 41, 29, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(232, 194, 113, 0.2); }

        /* 피파 스타일 카드 CSS */
        .fut-card {
            background: linear-gradient(135deg, #fceda1 0%, #e8c271 40%, #b08d41 100%);
            clip-path: polygon(10% 0, 90% 0, 100% 10%, 100% 90%, 90% 100%, 10% 100%, 0 90%, 0 10%);
            color: #332305;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5), inset 0 0 10px rgba(255,255,255,0.5);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
        }
        .fut-card::after {
            content: ''; position: absolute; top: 2px; left: 2px; right: 2px; bottom: 2px;
            clip-path: polygon(10% 0, 90% 0, 100% 10%, 100% 90%, 90% 100%, 10% 100%, 0 90%, 0 10%);
            border: 2px solid rgba(255,255,255,0.3); pointer-events: none;
        }
        .fut-card:hover { transform: translateY(-5px) scale(1.02); box-shadow: 0 15px 30px rgba(232, 194, 113, 0.4); z-index: 10; }
        
        .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; }
        .stat-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; font-weight: 700; }
        .stat-val { font-weight: 900; font-size: 1.1rem; font-family: 'Oswald', sans-serif; }

        .card-bronze { background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%); } 
        .card-silver { background: linear-gradient(135deg, #e2e2e2 0%, #999999 100%); }
        .card-gold { background: linear-gradient(135deg, #fceda1 0%, #e8c271 40%, #b08d41 100%); }
        .card-totw { background: linear-gradient(135deg, #111 0%, #333 100%); color: #e8c271; border: 1px solid #e8c271; }
        
        .floating-text { position: absolute; pointer-events: none; animation: floatUpFade 1s cubic-bezier(0.25, 1, 0.5, 1) forwards; font-weight: 900; z-index: 9999; text-shadow: 0 0 10px rgba(0,0,0,0.8); }
        @keyframes floatUpFade { 0% { transform: translateY(0) scale(1); opacity: 1; } 100% { transform: translateY(-40px) scale(1.5); opacity: 0; } }
        
        /* 툴팁 */
        .tooltip { visibility: hidden; position: absolute; z-index: 50; background-color: #11291d; color: #fff; text-align: center; border-radius: 6px; padding: 5px 10px; border: 1px solid #38ff8e; font-size: 0.75rem; bottom: 125%; left: 50%; transform: translateX(-50%); opacity: 0; transition: opacity 0.3s; white-space: nowrap; }
        .has-tooltip:hover .tooltip { visibility: visible; opacity: 1; }
    </style>
</head>
<body class="antialiased">

    <!-- 로그인 오버레이 -->
    <div id="loginOverlay" class="fixed inset-0 bg-pitch-bg z-[100] flex flex-col items-center justify-center px-4 transition-opacity duration-500">
        <div class="text-center mb-8">
            <i class="fa-regular fa-futbol text-5xl text-fut-rare mb-4 animate-bounce"></i>
            <h1 class="text-5xl font-display text-white tracking-widest drop-shadow-[0_0_15px_rgba(56,255,142,0.5)]">SAMBONG FC</h1>
            <p class="text-emerald-400 mt-2 font-bold">삼봉초 풋살클럽 (평일 훈련 & 주말 리그)</p>
        </div>

        <div class="glass-panel p-8 rounded-3xl max-w-sm w-full shadow-2xl border-t-4 border-t-fut-rare">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-slate-400 mb-1">직책 및 이름 선택</label>
                    <select id="loginId" class="w-full bg-slate-800 border border-slate-600 text-white rounded-xl px-4 py-3 focus:outline-none focus:border-fut-rare font-bold appearance-none mb-3">
                        <option value="" disabled selected>선택하세요</option>
                        <option value="player" class="text-fut-rare">👤 선수 (직접 이름 입력)</option>
                        <option disabled>─── 코칭 스태프 ───</option>
                        <option value="gm1" class="text-fut-gold">👑 전설감독 J (선생님)</option>
                        <option value="gm2" class="text-fut-gold">👑 수석코치 J (코치님)</option>
                    </select>
                    
                    <div id="playerNameInputContainer" class="hidden">
                        <input type="text" id="loginPlayerName" placeholder="자신의 이름을 정확히 입력하세요" class="w-full bg-slate-900 border border-emerald-600 text-white rounded-xl px-4 py-3 focus:outline-none focus:border-fut-rare font-bold text-center">
                    </div>
                </div>
                
                <div id="pinContainer">
                    <label class="block text-sm font-bold text-slate-400 mb-1">비밀번호 (PIN)</label>
                    <input type="password" id="loginPin" placeholder="4자리 숫자" class="w-full bg-slate-800 border border-slate-600 text-white rounded-xl px-4 py-3 focus:outline-none focus:border-fut-rare font-bold text-center tracking-[0.5em]" maxlength="4" pattern="[0-9]*" inputmode="numeric">
                </div>

                <button id="btnLogin" class="w-full bg-gradient-to-r from-emerald-600 to-green-500 hover:from-emerald-500 hover:to-green-400 text-white font-bold py-3 rounded-xl shadow-lg transition transform hover:scale-105 mt-4">
                    라커룸 입장
                </button>
            </div>
        </div>
    </div>

    <!-- 네비게이션 -->
    <nav class="fixed top-0 w-full z-50 glass-panel border-b border-emerald-900/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-shield-halved text-2xl text-fut-gold"></i>
                    <span class="font-display text-xl sm:text-2xl text-white tracking-wider">SAMBONG FC</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div id="saveStatus" class="hidden text-xs text-slate-400 items-center gap-2 bg-pitch-panel px-3 py-1.5 rounded-full border border-emerald-800">
                        <span id="playerNameDisplay" class="font-bold text-white"></span>
                    </div>
                    <button onclick="window.logout()" class="text-xs bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg transition border border-slate-600">
                        <i class="fa-solid fa-right-from-bracket"></i> 로그아웃
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="pt-24 pb-12 px-4 max-w-7xl mx-auto space-y-12">
        
        <!-- 헤더 -->
        <header class="text-center space-y-4">
            <h1 class="text-3xl sm:text-5xl font-display text-transparent bg-clip-text bg-gradient-to-r from-fut-rare to-emerald-200 drop-shadow-lg">
                얼티밋 스쿼드 관리소
            </h1>
            <p class="text-slate-400 max-w-2xl mx-auto break-keep">평일 훈련과 주말 리그 경기에서 활약하고 나만의 선수 카드를 전설 등급으로 성장시키세요!</p>
        </header>

        <!-- ★ 마스터(감독/코치) 전용 경기 기록 패널 ★ -->
        <section id="adminDashboard" class="hidden scroll-mt-24">
            <div class="glass-panel p-6 rounded-2xl mb-8 border border-fut-gold/50 shadow-[0_0_20px_rgba(232,194,113,0.15)] bg-gradient-to-br from-pitch-panel to-emerald-900/40">
                <h2 class="text-2xl font-display text-fut-gold mb-4 flex items-center gap-2"><i class="fa-solid fa-clipboard-list"></i> 선수단 스탯 및 출석부 관리 (코칭스태프 전용)</h2>
                
                <div class="overflow-x-auto pb-4">
                    <table class="w-full text-left text-sm text-slate-300 min-w-[800px]">
                        <thead class="text-xs uppercase bg-pitch-panel text-emerald-400 border-b border-emerald-800">
                            <tr>
                                <th class="px-2 py-3">선수 / OVR</th>
                                <th class="px-2 py-3 text-center">스탯 현황 (클릭 시 직접 수정)</th>
                                <th class="px-2 py-3 text-center">라이브 퀵 추가 (+1)</th>
                                <th class="px-2 py-3 text-center">평점 (OVR+) 및 자산 관리</th>
                            </tr>
                        </thead>
                        <tbody id="adminTableBody">
                            <!-- JS 렌더링 -->
                        </tbody>
                    </table>
                </div>

                <!-- ★ 관리자 전용 날짜별 스마트 출석부 ★ -->
                <div class="mt-8 pt-6 border-t border-emerald-800/50">
                    <h3 class="text-xl font-display text-emerald-400 mb-4 flex items-center gap-2"><i class="fa-regular fa-calendar-check"></i> 날짜별 출석부 관리</h3>
                    <p class="text-xs text-slate-400 mb-4">선수들을 체크하고 저장하면 해당 날짜의 출석 기록이 보관됩니다. 이전 기록을 클릭하면 당시의 출석 현황을 다시 불러옵니다.</p>
                    
                    <div class="flex flex-col sm:flex-row gap-4 mb-4 items-start sm:items-center">
                        <input type="date" id="adminAttDate" class="bg-slate-800 border border-emerald-700 rounded-xl px-4 py-2 text-white font-bold outline-none focus:border-fut-rare">
                        <button onclick="window.saveAdminAttendance()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-6 rounded-xl shadow-lg transition flex items-center">
                            <i class="fa-solid fa-floppy-disk mr-2"></i> 현재 체크된 출석 저장
                        </button>
                    </div>
                    
                    <div id="adminAttCheckboxes" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-2 mb-6">
                        <!-- JS 렌더링 (가나다 순) -->
                    </div>
                    
                    <h4 class="font-bold text-slate-300 mb-3 border-b border-slate-700 pb-1">저장된 과거 출석 기록 (클릭하여 불러오기)</h4>
                    <div id="adminAttHistory" class="flex gap-2 flex-wrap min-h-[40px]">
                        <span class="text-sm text-slate-500"><i class="fa-solid fa-spinner fa-spin"></i> 기록을 불러오는 중...</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="grid lg:grid-cols-12 gap-8">
            <!-- 좌측: 내 카드 & 스탯 -->
            <div class="lg:col-span-4 space-y-6 flex flex-col items-center lg:items-start">
                
                <!-- 👑 내 FUT 카드 -->
                <div id="myFutCard" class="fut-card card-gold w-64 h-96 p-4 flex flex-col justify-between mx-auto lg:mx-0">
                    <div class="flex justify-between items-start">
                        <div class="flex flex-col items-center relative">
                            <span class="font-oswald text-4xl font-bold leading-none" id="cardOvr">85</span>
                            <div class="has-tooltip cursor-pointer flex items-center gap-1 hover:text-white transition" onclick="window.openPositionModal()">
                                <span class="font-oswald text-sm font-bold" id="cardPos">ST</span>
                                <i class="fa-solid fa-pen text-[10px] opacity-50"></i>
                                <span class="tooltip">포지션 변경</span>
                            </div>
                            <div class="mt-1 flex items-center justify-center text-xl leading-none drop-shadow-sm">🇰🇷</div>
                        </div>
                        <div class="text-6xl pt-2 pr-2 drop-shadow-md" id="cardAvatar">👦</div>
                    </div>
                    
                    <div class="text-center border-b border-black/20 pb-1 mb-2 mt-2">
                        <h2 class="font-display text-xl uppercase tracking-wider truncate px-2" id="cardName">선수 이름</h2>
                    </div>

                    <div class="stat-grid pb-2">
                        <div class="stat-row"><span>속력</span><span class="stat-val" id="statPac">85</span></div>
                        <div class="stat-row"><span>드리블</span><span class="stat-val" id="statDri">88</span></div>
                        <div class="stat-row"><span>슈팅</span><span class="stat-val" id="statSho">82</span></div>
                        <div class="stat-row"><span>수비</span><span class="stat-val" id="statDef">40</span></div>
                        <div class="stat-row"><span>패스</span><span class="stat-val" id="statPas">80</span></div>
                        <div class="stat-row"><span>피지컬</span><span class="stat-val" id="statPhy">75</span></div>
                    </div>
                </div>

                <!-- 누적 기록 요약 및 주급 받기 -->
                <div class="glass-panel p-5 rounded-2xl w-full max-w-sm mx-auto lg:mx-0">
                    <h3 class="font-bold text-lg mb-4 text-emerald-400 border-b border-emerald-800 pb-2 flex justify-between items-center">
                        <span><i class="fa-solid fa-chart-simple mr-2"></i> 내 시즌 기록</span>
                    </h3>
                    
                    <div class="grid grid-cols-3 gap-2 text-center text-sm mb-2">
                        <div class="bg-pitch-bg p-2 rounded border border-emerald-900">
                            <div class="text-[10px] text-slate-400">경기 출장</div>
                            <div class="font-bold text-white text-lg" id="recordMatches">0</div>
                        </div>
                        <div class="bg-pitch-bg p-2 rounded border border-emerald-900">
                            <div class="text-[10px] text-slate-400">평일 훈련</div>
                            <div class="font-bold text-emerald-400 text-lg" id="recordTraining">0</div>
                        </div>
                        <div class="bg-pitch-bg p-2 rounded border border-emerald-900">
                            <div class="text-[10px] text-slate-400">골 ⚽</div>
                            <div class="font-bold text-fut-gold text-lg" id="recordGoals">0</div>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-3 gap-2 text-center text-sm">
                        <div class="bg-pitch-bg p-2 rounded border border-emerald-900">
                            <div class="text-[10px] text-slate-400">어시스트 👟</div>
                            <div class="font-bold text-blue-400 text-lg" id="recordAssists">0</div>
                        </div>
                        <div class="bg-pitch-bg p-2 rounded border border-emerald-900">
                            <div class="text-[10px] text-slate-400">킬패스 🎯</div>
                            <div class="font-bold text-purple-400 text-lg" id="recordKeypasses">0</div>
                        </div>
                        <div class="bg-pitch-bg p-2 rounded border border-emerald-900">
                            <div class="text-[10px] text-slate-400">세이브 🧤</div>
                            <div class="font-bold text-orange-400 text-lg" id="recordSaves">0</div>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-col gap-2">
                        <div class="flex justify-between items-center bg-pitch-bg p-3 rounded-xl border border-fut-gold/30">
                            <span class="text-sm font-bold text-slate-300">누적 자산 (B)</span>
                            <span class="font-bold text-xl text-fut-gold"><span id="recordBong">0</span> B</span>
                        </div>
                        <button onclick="window.claimWage()" class="w-full bg-gradient-to-r from-fut-gold-dark to-fut-gold hover:from-fut-gold hover:to-yellow-200 text-slate-900 font-bold py-2.5 rounded-xl shadow-lg transition flex justify-between items-center px-4">
                            <span><i class="fa-solid fa-sack-dollar mr-2"></i> 이번 주 주급 받기</span>
                            <span class="text-sm bg-black/20 px-2 py-1 rounded-md" id="expectedWageDisplay">예상 주급: ? B</span>
                        </button>
                        <p class="text-[10px] text-slate-500 text-center"><i class="fa-solid fa-circle-info"></i> 주급은 카드 능력치(OVR)가 높을수록 많이 받습니다! (매주 1회)</p>
                    </div>
                </div>
            </div>

            <!-- 우측: 랜덤 팀 메이커 & 전체 스쿼드 -->
            <div class="lg:col-span-8 space-y-8">
                
                <!-- 🎲 팀 배정 보드 (선수용) -->
                <div class="glass-panel p-6 rounded-2xl border-t-4 border-t-blue-500">
                    <h3 class="text-2xl font-display text-white mb-2 flex items-center gap-2"><i class="fa-solid fa-users-gear text-blue-400"></i> 스마트 팀 배정 보드</h3>
                    <p class="text-sm text-slate-400 mb-6">오늘 참여한 선수를 체크하고 버튼을 누르면, <strong>선수들의 포지션(공격/미드/수비/키퍼)을 골고루 배분</strong>하여 공평하게 팀을 섞어줍니다.</p>
                    
                    <div id="attendanceBoard" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-6">
                        <div class="text-center text-slate-500 col-span-full"><i class="fa-solid fa-spinner fa-spin"></i> 선수 데이터를 불러오는 중...</div>
                    </div>
                    
                    <button onclick="window.generateTeams()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl shadow-lg transition transform hover:scale-[1.01] active:scale-95 text-lg">
                        <i class="fa-solid fa-shuffle mr-2"></i> 포지션 밸런스 맞춰서 팀 섞기
                    </button>

                    <div id="teamResult" class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 hidden">
                        <div class="bg-blue-900/20 border border-blue-500/50 p-4 rounded-xl">
                            <h4 class="font-display text-xl text-blue-400 mb-3 text-center border-b border-blue-500/30 pb-2">TEAM A (블루)</h4>
                            <ul id="teamA" class="space-y-2 text-sm font-bold"></ul>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/50 p-4 rounded-xl">
                            <h4 class="font-display text-xl text-red-400 mb-3 text-center border-b border-red-500/30 pb-2">TEAM B (레드)</h4>
                            <ul id="teamB" class="space-y-2 text-sm font-bold"></ul>
                        </div>
                    </div>
                </div>

                <!-- ⚽ 전체 선수단 명단 (Leaderboard) -->
                <div class="glass-panel p-6 rounded-2xl">
                    <h3 class="text-2xl font-display text-white mb-4"><i class="fa-solid fa-ranking-star text-fut-gold"></i> 클럽 스쿼드 랭킹 (OVR 순)</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="squadContainer">
                        <div class="text-center text-slate-500 col-span-full py-8"><i class="fa-solid fa-spinner fa-spin"></i> 선수 데이터를 불러오는 중...</div>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Firebase -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, collection, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = 'sambong-futsal-2026'; 

        // ★ 가나다순으로 자동 정렬된 허용 선수 명단 ★
        const ALLOWED_PLAYERS = [
            '김단엘', '박현수', '백시율', '조이담', '황훈태', '김지훈', '이준용', '이지안', '인시진', '박준수', '이시형', '황주하', '이동해',
            '김라희', '박소윤', '박하율', '임은영', '김민지', '황혜윤', '최윤희', '노승희', '이가온', '이예주', '황혜민', '김사랑비', '김다래', '함인솔'
        ].sort((a,b) => a.localeCompare(b));

