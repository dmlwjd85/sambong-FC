        async function attemptLogin(pId, pin, isAuto) {
            if(!auth.currentUser) return;
            const isGM = pId === 'gm1' || pId === 'gm2';
            let displayName = isGM ? (pId === 'gm1' ? '전설감독 J' : '수석코치 J') : pId;
            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'players', 'player_' + pId);
            
            try {
                const snap = await getDoc(docRef);
                if(snap.exists()) {
                    const data = snap.data();
                    if(!data.pin) {
                        if(isAuto) return;
                        if(!await window.customConfirm(`PIN [${pin}]으로 초기 등록하시겠습니까?`)) return;
                        window.playerState = { ...data, pin, isGM };
                        await setDoc(docRef, { pin }, { merge: true });
                    } else if(data.pin !== pin) {
                        if(isAuto) { localStorage.clear(); location.reload(); return; }
                        return window.customAlert("❌ 비밀번호가 틀렸습니다.");
                    } else { window.playerState = { ...data, isGM }; }
                } else {
                    if(isAuto) return;
                    if(!await window.customConfirm(`[${displayName}] 선수!\nPIN [${pin}]으로 신규 카드를 발급하시겠습니까?`)) return;
                    
                    const r = () => Math.floor(Math.random() * 11) + 55;
                    const base = { pac: r(), sho: r(), pas: r(), dri: r(), def: r(), phy: r() };
                    const ovr = Math.floor((base.pac + base.sho + base.pas + base.dri + base.def + base.phy)/6);
                    
                    window.playerState = { pin, isGM, name: displayName, pos: 'CM', ovr, ...base, goals:0, assists:0, matches:0, training:0, saves:0, keypasses:0, bong:0, lastWageWeek: '' };
                    await setDoc(docRef, window.playerState);
                }

                localStorage.setItem('futsal_player_id', pId); localStorage.setItem('futsal_player_pin', pin);
                currentDocRef = docRef;
                
                document.getElementById('loginOverlay').classList.add('hidden');
                document.getElementById('saveStatus').classList.remove('hidden');
                document.getElementById('saveStatus').classList.add('flex');
                document.getElementById('playerNameDisplay').innerText = displayName;
                
                if(isGM) {
