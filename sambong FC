        window.generateTeams = () => {
            const checkboxes = document.querySelectorAll('.attendance-chk:checked');
            if(checkboxes.length < 2) return window.customAlert("팀을 나누려면 최소 2명 이상의 선수를 출석 체크해주세요!");

            const pools = { GK: [], DF: [], MF: [], FW: [] };
            const roleMap = {
                'ST':'FW', 'LW':'FW', 'RW':'FW', 'CF':'FW',
                'CAM':'MF', 'CM':'MF', 'CDM':'MF', 
                'CB':'DF', 'LB':'DF', 'RB':'DF', 
                'GK':'GK'
            };

            checkboxes.forEach(cb => {
                const name = cb.getAttribute('data-name');
                const pos = cb.getAttribute('data-pos');
                const role = roleMap[pos] || 'MF'; 
                pools[role].push(`${name} [${pos}]`);
            });

            for(let role in pools) { pools[role].sort(() => Math.random() - 0.5); }

            const teamA = []; const teamB = [];
            let turnA = true; 

            ['GK', 'DF', 'MF', 'FW'].forEach(role => {
                pools[role].forEach(player => {
                    if(turnA) teamA.push(player); else teamB.push(player);
                    turnA = !turnA; 
                });
            });

            document.getElementById('teamResult').classList.remove('hidden');
            
            const ulA = document.getElementById('teamA');
            ulA.innerHTML = '';
            teamA.forEach(p => ulA.innerHTML += `<li class="text-blue-200 border-b border-blue-500/20 pb-1 mb-1"><i class="fa-solid fa-shirt mr-2"></i>${p}</li>`);
            
