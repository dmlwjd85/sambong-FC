                    renderAdminAttendanceUI();
                }

                onSnapshot(docRef, (s) => {
                    if(s.exists()) { window.playerState = { ...s.data(), isGM }; updateMyUI(); }
                });
            } catch(e) { window.customAlert("로그인 에러: " + e.message); }
        }

