                            <div class="flex justify-between bg-slate-800/60 px-1.5 py-0.5 rounded cursor-pointer hover:bg-slate-700 transition" onclick="editPlayerStat('${p.id}', 'assists', ${p.assists||0}, '${p.name}', '어시')"><span class="text-slate-400">어시</span><span class="font-bold text-blue-400">${p.assists||0}</span></div>
                            <div class="flex justify-between bg-slate-800/60 px-1.5 py-0.5 rounded cursor-pointer hover:bg-slate-700 transition" onclick="editPlayerStat('${p.id}', 'keypasses', ${p.keypasses||0}, '${p.name}', '킬패스')"><span class="text-slate-400">킬패스</span><span class="font-bold text-purple-400">${p.keypasses||0}</span></div>
                            <div class="flex justify-between bg-slate-800/60 px-1.5 py-0.5 rounded cursor-pointer hover:bg-slate-700 transition" onclick="editPlayerStat('${p.id}', 'saves', ${p.saves||0}, '${p.name}', '세이브')"><span class="text-slate-400">세이브</span><span class="font-bold text-orange-400">${p.saves||0}</span></div>
                        </div>
                    </td>
                    <td class="px-2 py-3 text-center border-l border-emerald-900/50">
                        <div class="flex justify-center gap-1 flex-wrap max-w-[120px] mx-auto">
                            <button onclick="updatePlayerStat('${p.id}', 'matches', 1)" class="bg-slate-700 hover:bg-slate-600 px-1.5 py-1 rounded text-[10px] text-white transition">경기+1</button>
                            <button onclick="updatePlayerStat('${p.id}', 'training', 1)" class="bg-emerald-900 hover:bg-emerald-700 px-1.5 py-1 rounded text-[10px] text-emerald-300 transition">훈련+1</button>
                            <button onclick="updatePlayerStat('${p.id}', 'goals', 1)" class="bg-yellow-900/40 hover:bg-yellow-700 px-1.5 py-1 rounded text-[10px] text-yellow-300 transition">골+1</button>
                            <button onclick="updatePlayerStat('${p.id}', 'assists', 1)" class="bg-blue-900/40 hover:bg-blue-700 px-1.5 py-1 rounded text-[10px] text-blue-300 transition">어시+1</button>
                        </div>
                    </td>
                    <td class="px-2 py-3 text-center border-l border-emerald-900/50">
                        <div class="flex flex-col gap-1 items-center">
                            <button onclick="giveRating('${p.id}')" class="bg-emerald-600/30 hover:bg-emerald-500 text-emerald-300 hover:text-white border border-emerald-500 px-3 py-1.5 rounded-lg text-xs font-bold shadow-lg transition whitespace-nowrap">OVR 훈련/상승</button>
                            <div class="flex gap-1 w-full justify-center mt-1">
                                <button onclick="updatePlayerStat('${p.id}', 'bong', 5)" class="bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded text-[10px] text-yellow-400 font-bold transition">+5 B</button>
                                <button onclick="updatePlayerStat('${p.id}', 'bong', -5)" class="bg-slate-800 hover:bg-red-900 px-2 py-1 rounded text-[10px] text-red-400 font-bold transition">-5 B</button>
                            </div>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // 마스터 전용 개별 스탯 직접 수정 로직
        window.editPlayerStat = async (pId, statField, currentVal, pName, statLabel) => {
            if(!window.playerState.isGM) return;
            const val = await window.customPrompt(`[${pName}] 선수의 '${statLabel}' 기록을 직접 수정합니다.\n원하시는 최종 숫자를 입력하세요. (현재: ${currentVal})`, 'number');
            
            if(val !== null && val !== "") {
                const num = parseInt(val);
                if(!isNaN(num) && num >= 0) {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'players', 'player_' + pId);
                    await setDoc(docRef, { [statField]: num }, {merge: true});
                    // 직접 수동 조작 시에는 중복 보상을 막기 위해 자동 B 지급 로직을 타지 않습니다.
                } else {
                    window.customAlert("0 이상의 유효한 숫자를 입력하세요.");
                }
            }
        };

        window.updatePlayerStat = async (pId, statField, amount) => {
            if(!window.playerState.isGM) return;
            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'players', 'player_' + pId);
            const p = window.allPlayersData.find(x => x.id === pId);
            if(!p) return;
            
            let newVal = (p[statField] || 0) + amount;
            if(newVal < 0) newVal = 0;
            
            let updates = {}; updates[statField] = newVal;
            
            // 특수 스탯 입력시 보너스 자산(B) 자동 지급
            if(amount > 0) {
                if(statField === 'goals') { updates.bong = (p.bong||0) + 3; animateFloatText('⚽ +3 B', 'text-fut-gold'); }
                if(statField === 'assists') { updates.bong = (p.bong||0) + 2; animateFloatText('👟 +2 B', 'text-fut-gold'); }
                if(statField === 'matches') { updates.bong = (p.bong||0) + 5; animateFloatText('🏃 +5 B', 'text-fut-gold'); }
                if(statField === 'training') { updates.bong = (p.bong||0) + 1; animateFloatText('💪 +1 B', 'text-emerald-400'); }
            }

            await setDoc(docRef, updates, { merge: true });
        }

        window.giveRating = async (pId) => {
            if(!window.playerState.isGM) return;
            const points = await window.customPrompt("훈련 및 경기 보상으로 올릴 OVR 포인트를 입력하세요 (예: 1~3)", "number");
            if(points === null || points === "") return;
            const num = parseInt(points);
            if(isNaN(num) || num <= 0) return window.customAlert("1 이상의 유효한 숫자를 입력하세요.");

            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'players', 'player_' + pId);
            const p = window.allPlayersData.find(x => x.id === pId);
            
            let updates = {
                ovr: (p.ovr||60) + num,
                pac: (p.pac||60) + num, sho: (p.sho||60) + num, pas: (p.pas||60) + num,
                dri: (p.dri||60) + num, def: (p.def||60) + num, phy: (p.phy||60) + num
            };
            await setDoc(docRef, updates, { merge: true });
            window.customAlert("능력치가 성공적으로 업그레이드 되었습니다!");
        }

        function animateFloatText(text, colorClass) {
            const f = document.createElement('div');
            f.className = `fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-5xl font-display ${colorClass} z-[300] whitespace-nowrap drop-shadow-xl`;
            f.innerText = text;
            f.animate([ 
                { transform: 'translate(-50%, -50%) scale(0.8)', opacity: 0 }, 
                { transform: 'translate(-50%, -60%) scale(1.2)', opacity: 1, offset: 0.2 },
                { transform: 'translate(-50%, -100%) scale(1.5)', opacity: 0 } 
            ], { duration: 1500, easing: 'ease-out' });
            document.body.appendChild(f);
            setTimeout(() => f.remove(), 1500);
        }

        // ==========================================
        // 모달 및 포지션
        // ==========================================
        window.openPositionModal = () => {
            if(window.playerState.isGM) return; 

            const modal = document.createElement('div');
            modal.className = "fixed inset-0 z-[200] flex items-center justify-center bg-black/80 px-4";
            
            const posList = [
                { id: 'ST', desc: '스트라이커 (최전방 공격수)' }, { id: 'LW', desc: '레프트 윙어 (좌측면 공격)' }, { id: 'RW', desc: '라이트 윙어 (우측면 공격)' },
                { id: 'CAM', desc: '공격형 미드필더 (플레이메이커)' }, { id: 'CM', desc: '중앙 미드필더 (게임 조율)' }, { id: 'CDM', desc: '수비형 미드필더 (진공청소기)' },
                { id: 'CB', desc: '센터백 (최후방 벽)' }, { id: 'LB', desc: '레프트 백 (좌측 수비)' }, { id: 'RB', desc: '라이트 백 (우측 수비)' },
                { id: 'GK', desc: '골키퍼 (거미손)' }
            ];

            let btnsHtml = posList.map(pos => `
                <button onclick="window.selectPosition('${pos.id}')" class="bg-pitch-panel hover:bg-emerald-900 border border-emerald-800 p-3 rounded-xl text-left transition group">
                    <div class="font-oswald text-lg font-bold text-fut-gold group-hover:text-white">${pos.id}</div>
                    <div class="text-xs text-slate-400 mt-1">${pos.desc}</div>
                </button>
            `).join('');

            modal.innerHTML = `
                <div class="bg-pitch-bg p-6 sm:p-8 rounded-3xl border-2 border-fut-gold max-w-lg w-full shadow-2xl max-h-[90vh] flex flex-col">
                    <h3 class="text-2xl font-display text-white mb-2 text-center">선호 포지션 변경</h3>
                    <p class="text-xs text-slate-400 text-center mb-6">자신이 소화하고 싶은 주력 포지션을 선택하세요. 카드에 즉시 반영되며, <strong>팀 배정 시 밸런스를 맞추는 기준</strong>이 됩니다.</p>
                    <div class="grid grid-cols-2 gap-3 overflow-y-auto pr-2 custom-scrollbar flex-grow">
                        ${btnsHtml}
                    </div>
                    <button onclick="this.parentElement.parentElement.remove()" class="mt-6 bg-slate-700 hover:bg-slate-600 text-white font-bold py-3 px-6 rounded-xl w-full transition">닫기</button>
                </div>
            `;
            document.body.appendChild(modal);
            window.currentPosModal = modal;
        };

        window.selectPosition = async (newPos) => {
            if(!currentDocRef) return;
            await setDoc(currentDocRef, { pos: newPos }, { merge: true });
            if(window.currentPosModal) window.currentPosModal.remove();
            window.customAlert(`포지션이 [${newPos}] (으)로 성공적으로 변경되었습니다!`);
        };

        window.renderSquad = function() {
            const container = document.getElementById('squadContainer');
            if(!window.allPlayersData || window.allPlayersData.length === 0) return;
            
            // 랭킹 카드는 변함없이 OVR순 유지
            container.innerHTML = window.allPlayersData.map(p => {
                let bgClass = "bg-gradient-to-br from-[#aa771c] to-[#d4af37]"; 
                if(p.ovr >= 85) bgClass = "bg-gradient-to-br from-gray-900 to-black border border-fut-gold text-fut-gold";
                else if(p.ovr >= 75) bgClass = "bg-gradient-to-br from-[#e8c271] to-[#b08d41] text-yellow-900";
                else if(p.ovr >= 65) bgClass = "bg-gradient-to-br from-gray-300 to-gray-500 text-gray-900";

                return `
                <div class="rounded-xl p-3 flex flex-col items-center justify-center relative overflow-hidden shadow-lg transform transition hover:scale-105 ${bgClass}">
                    <div class="text-3xl font-oswald font-bold">${p.ovr || 60}</div>
                    <div class="text-[10px] font-bold opacity-80">${p.pos || 'CF'}</div>
                    <div class="text-3xl mt-1 mb-1 drop-shadow-md">👦</div>
                    <div class="font-bold text-sm truncate w-full text-center">${p.name}</div>
                    <div class="flex flex-wrap justify-center gap-1 text-[9px] mt-1 opacity-80 font-bold px-1">
                        <span>⚽${p.goals||0}</span><span>👟${p.assists||0}</span>
                        ${p.saves ? `<span>🧤${p.saves}</span>` : ''}
                    </div>
                </div>`;
            }).join('');
        }

        initApp();
    </script>
</body>
</html>
